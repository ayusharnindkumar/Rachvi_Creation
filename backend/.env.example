# ================================
# Rachvi Creation - Backend .env
# ================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your actual MongoDB URI from atlas.mongodb.com
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/rachvi_creation?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=rachvi_creation_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=30d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Cloudinary (for image uploads)
# Get from cloudinary.com -> Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay Payment Gateway
# Get from razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
